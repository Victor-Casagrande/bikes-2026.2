<jasperReport name="clientes-bikes" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0a218f41-8abd-49ee-8812-6f5002c31c2f">
	<parameter name="IMG_DIR" forPrompting="false" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT c.id, c.nome, c.cpf, u.username AS email, c.data_criacao FROM clientes c INNER JOIN usuarios u ON u.id = c.id_usuario ORDER BY c.nome]]></query>
	<field name="id" class="java.lang.Long"/>
	<field name="nome" class="java.lang.String"/>
	<field name="cpf" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="data_criacao" class="java.sql.Timestamp"/>
