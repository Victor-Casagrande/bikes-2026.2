{
  "info": {
    "name": "Bikes",
    "description": "API da locadora de bicicletas (IFC Videira). Execute as pastas na ordem: o login guarda os tokens e a solicitação de locação guarda o id usado na devolução.\n\nVariáveis da coleção: baseUrl, adminUsername, clienteUsername e senha. Se o banco já tiver um admin, o 'Criar admin' só funciona depois do login do admin (403 é esperado na 1ª vez).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// data prevista de devolução: amanhã às 18h (formato ISO aceito pela API)",
          "const d = new Date(Date.now() + 24 * 60 * 60 * 1000);",
          "const p = n => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('dataPrevista', `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T18:00:00`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "adminUsername",
      "value": "admin@bikes.com"
    },
    {
      "key": "clienteUsername",
      "value": "cliente@bikes.com"
    },
    {
      "key": "senha",
      "value": "123456"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "idLocacao",
      "value": ""
    },
    {
      "key": "dataPrevista",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Usuários e autenticação",
      "item": [
        {
          "name": "Criar admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "O primeiro admin do sistema pode ser criado sem token; depois, só um admin cria outro. Se o usuário já existir, a resposta é 409.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{senha}}\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
